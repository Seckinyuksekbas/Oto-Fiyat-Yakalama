# Oto Fırsat — GELİŞTİRME env şablonu (yalnız yer tutucu/yerel değerler). `cp .env.example .env`
# Production için bu dosyayı DEĞİL .env.prod.example'ı kullanın (docs/operations/deploy.md).
# Windows: komutları Git Bash'te çalıştırın (PowerShell 5.1 `>>` UTF-16 yazar ve .env'i bozar).

# --- Çalışma ortamı ---
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
# Tarayıcının uygulamaya eriştiği adres (cookie/Origin kontrolü ve e-posta linkleri için)
PUBLIC_BASE_URL=http://localhost:3000
# Yerelde HTTP kullanıldığı için false; production'da true olmalı
COOKIE_SECURE=false
# Önümüzdeki güvenilir ters vekil (Caddy vb.) sayısı; istemci IP'si X-Forwarded-For'dan buna göre okunur (0-5, varsayılan 1)
TRUST_PROXY=1
# Production (NODE_ENV=production) ek kuralları: COOKIE_SECURE=true, PUBLIC_BASE_URL https ve localhost olmayan,
# MAIL_TRANSPORT=smtp, SMTP_HOST localhost olmayan bir sunucu, SMTP_PORT açıkça verilmiş ve 1025 değil,
# SMTP_FROM alan adı localhost olmayan; SMTP_USER varsa SMTP_SECURE ya da SMTP_REQUIRE_TLS true. Aksi halde api açılmaz.

# --- Veritabanı / Redis (docker-compose.dev.yml ile uyumlu) ---
# Not: Diğer yerel yığınlarla çakışmamak için varsayılan olmayan host portları (5433, 6380) kullanılır.
DATABASE_URL=postgresql://oto:oto@localhost:5433/oto
REDIS_URL=redis://localhost:6380

# --- Gizli anahtarlar: `pnpm -s keys:gen >> .env` ile üretin ---
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# DATA_ENCRYPTION_KEY=<base64, 32 bayt>

# --- E-posta (dev: Mailpit, arayüz http://localhost:8025) ---
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
# Geliştirmede verilmezse 1025 (Mailpit); production'da zorunlu (587 STARTTLS ya da 465 TLS)
SMTP_PORT=1025
# Production'da gönderen alan adı gerçek bir alan olmalı (localhost reddedilir)
SMTP_FROM="Oto Fırsat <no-reply@localhost>"
# SMTP kimlik doğrulama (Mailpit'te gerekmez). SMTP_USER verilirse SMTP_PASS zorunludur.
# SMTP_USER=
# SMTP_PASS=
# true: bağlantı baştan TLS (465); false: düz bağlantı + STARTTLS (587). 465+false ve 587+true reddedilir.
SMTP_SECURE=false
# STARTTLS zorunlu olsun mu? Boş bırakılırsa production'da true, diğer ortamlarda false
# SMTP_REQUIRE_TLS=true

# --- Güvenlik ---
# Şifreleri HaveIBeenPwned k-anonymity API'siyle kontrol et (dış erişim gerekir).
# Verilmezse production'da true, diğer ortamlarda false; production'da kapatmak için açıkça false yazın.
HIBP_ENABLED=false

# --- Seed: ilk süper admin ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please-123

# --- Toplama hattı (apps/worker) ---
# Bot User-Agent'ında yayınlanan iletişim adresi: "OtoFirsatBot/1.0 (+<adres>)"
BOT_CONTACT_URL=http://localhost:3000/bot
SCHEDULER_TICK_MS=15000
SCRAPE_CONCURRENCY=2
ANALYZE_CONCURRENCY=4
MATCH_CONCURRENCY=4
NOTIFY_CONCURRENCY=8
# Alarm monitörü (scheduler) en fazla bu aralıkla çalışır (ms, varsayılan 60000)
MONITOR_INTERVAL_MS=60000
# Kapanışta aktif işlerin bitmesi için beklenecek süre (ms, en fazla 38000: +5 sn zorla kapatma ve ~2 sn bağlantı kapatma
# payıyla compose stop_grace_period 45s içinde kalır);
# aşılırsa worker zorla kapanır, işler stalled olarak yeniden işlenir
SHUTDOWN_TIMEOUT_MS=30000
# Worker: DATABASE_URL'de ?connection_limit=N, N >= SCRAPE+ANALYZE+MATCH+NOTIFY_CONCURRENCY + NOTIFY_TELEGRAM(5) + 3
# (varsayılanlarla 26); ROLE=scheduler için en az 3. Production'da eksik/düşükse süreç başlamaz; development/test'te yalnız uyarır.
# Parola özel karakter içeriyorsa percent-encode edilmelidir.

# --- Demo ilan sitesi (yalnızca geliştirme) ---
# Demo sitesi yalnızca geliştirme içindir; NODE_ENV=production ile başlamayı reddeder.
DEMO_HOST=127.0.0.1
DEMO_PORT=4000
DEMO_SEED=42
DEMO_SIZE=2000
DEMO_TICK_MS=60000
# `pnpm db:seed` demo kaynağı da kaydetsin (NODE_ENV=production iken true ise seed hata verip çıkar):
SEED_DEMO_SOURCE=true
DEMO_SITE_URL=http://localhost:4000

# --- Telegram (isteğe bağlı; docs/operations/telegram-bot.md) ---
# TELEGRAM_BOT_TOKEN yoksa bağlama akışı 503 FEATURE_DISABLED döner. Token api VE worker'da gerekir (scheduler'da değil);
# production worker'ı token yoksa açılışta uyarır ve SystemLog'a WARN yazar.
# polling: API getUpdates ile yoklar (yalnız geliştirme). webhook: Telegram /api/v1/telegram/webhook'a POST eder,
# X-Telegram-Bot-Api-Secret-Token başlığıyla (secret 32-256 karakter [A-Za-z0-9_-]). Production'da webhook zorunlu.
# Webhook kurulumu: pnpm telegram:webhook set|info|delete (yalnız süreç ortamını okur).
TELEGRAM_MODE=polling
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_API_BASE=https://api.telegram.org

# Web (Next.js) — /api/* istekleri buraya yönlendirilir. http(s) URL olmalı (http serbest: iç ağ adresi).
# `next build` sırasında rewrites'a gömülür (sonradan değiştirmek etkisizdir); gizli değildir.
# Geçersizse derleme ve `next start` açılışı durur.
API_ORIGIN=http://localhost:3001
# CSP img-src'e eklenecek, boşlukla ayrılmış http(s) origin'leri (çalışma zamanında okunur; https görseller zaten serbest,
# yalnız production derlemesinde http üzerinden sunulan görsel kaynakları için gerekir; geliştirmede http: zaten serbest).
# Geçersizse web açılmaz.
# CSP_IMG_EXTRA=http://localhost:4000

# --- Admin paneli (apps/api) ---
# Proxy sağlık kontrolünün proxy üzerinden istek attığı adres
PROXY_CHECK_URL=https://www.gstatic.com/generate_204
