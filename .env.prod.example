# Oto Fırsat — production env şablonu (docker-compose.yml). YALNIZ YER TUTUCU içerir.
#
#   cp .env.prod.example .env.prod && chmod 600 .env.prod     # .env.prod gitignore'lu; repoya asla girmez
#   docker compose --env-file .env.prod up -d --build --wait
#
# Compose bu dosyayı değişken kaynağı olarak okur ve her servise yalnız ihtiyacı olanları aktarır.
# [zorunlu] eksikse compose başlamaz; [isteğe bağlı] satırı silinirse uygulama varsayılanı kullanılır.
# Sabitlenenler (compose'da, burada değiştirilemez): NODE_ENV=production, COOKIE_SECURE=true, TRUST_PROXY=1,
# MAIL_TRANSPORT=smtp, SEED_DEMO_SOURCE=false, API_ORIGIN=http://api:3001.
# Uygulamalar açılışta production kurallarını ayrıca doğrular; güvensiz değerde süreç açılmaz.
#
# DİKKAT — öncelik: kabukta export edilmiş aynı adlı değişkenler bu dosyayı EZER. Compose'u temiz bir kabukta
# çalıştırın: env -i HOME="$HOME" PATH="$PATH" docker compose --env-file .env.prod up -d --wait
# DİKKAT — sır ifşası: `docker compose config` ve `docker inspect` çözülmüş değerleri (parolalar, anahtarlar) açık
# metin yazdırır; çıktılarını hiçbir yere yapıştırmayın.
# Parolalar URL'ye ve Redis yapılandırmasına gömülür: yalnız [A-Za-z0-9] kullanın (openssl rand -hex).

# --- Site / Caddy ---------------------------------------------------------------------------------
# [zorunlu] Caddy site adresi: alan adı (DNS A/AAAA kaydı bu sunucuyu göstermeli; 80/443 açık olmalı)
SITE_ADDRESS=oto.example.com
# [zorunlu] Let's Encrypt hesap e-postası (sertifika uyarıları)
ACME_EMAIL=ops@example.com
# [zorunlu] Tarayıcının eriştiği adres: https, localhost/loopback olamaz; SITE_ADDRESS ile aynı origin
PUBLIC_BASE_URL=https://oto.example.com
# [zorunlu] Bot User-Agent'ında yayınlanan iletişim sayfası (https, loopback olamaz)
BOT_CONTACT_URL=https://oto.example.com/bot

# --- Veritabanı / Redis ---------------------------------------------------------------------------
# [isteğe bağlı] varsayılan: oto
POSTGRES_USER=oto
POSTGRES_DB=oto
# [zorunlu] URL-güvenli olmalı (DATABASE_URL'ye gömülür): `openssl rand -hex 24`
POSTGRES_PASSWORD=<openssl rand -hex 24>
# [zorunlu] Redis parolası (URL-güvenli): `openssl rand -hex 24`
REDIS_PASSWORD=<openssl rand -hex 24>
# [isteğe bağlı] Prisma havuz boyutları (connection_limit). Worker: >= SCRAPE+ANALYZE+MATCH+NOTIFY_CONCURRENCY + 5 + 3
# (varsayılanlarla 26); scheduler: >= 3. Toplam (api + worker*replika + scheduler + ~10) POSTGRES_MAX_CONNECTIONS (varsayılan 150)
# altında kalmalı (aşağıdaki Worker / scheduler bölümü; docs/operations/deploy.md).
# API_DB_CONNECTION_LIMIT=10
# WORKER_DB_CONNECTION_LIMIT=30
# SCHEDULER_DB_CONNECTION_LIMIT=5

# --- Gizli anahtarlar: `node scripts/gen-keys.mjs` çıktısını buraya yapıştırın ----------------------
# [zorunlu] Ed25519 PKCS8 PEM (tek satır, \n kaçışlı, çift tırnak içinde) — yalnız api
JWT_PRIVATE_KEY="<gen-keys.mjs çıktısı>"
# [zorunlu] Ed25519 SPKI PEM — yalnız api
JWT_PUBLIC_KEY="<gen-keys.mjs çıktısı>"
# [zorunlu] base64, 32 bayt — api + worker + scheduler (Telegram/proxy sırlarını şifreler; DEĞİŞTİRMEYİN, yedekleyin)
DATA_ENCRYPTION_KEY=<gen-keys.mjs çıktısı>

# --- E-posta (api) ----------------------------------------------------------------------------------
# [zorunlu] localhost/loopback olamaz
SMTP_HOST=smtp.example.com
# [zorunlu] 587 (STARTTLS, SMTP_SECURE=false) ya da 465 (TLS, SMTP_SECURE=true); 1025 reddedilir
SMTP_PORT=587
# [zorunlu] gönderen; alan adı localhost olamaz
SMTP_FROM="Oto Fırsat <no-reply@example.com>"
# [isteğe bağlı] kimlik doğrulama; biri verilirse diğeri zorunlu (verilirse STARTTLS/TLS zorunlu kalır)
# SMTP_USER=<smtp kullanıcı adı>
# SMTP_PASS=<smtp parolası>
# [isteğe bağlı] varsayılan false; 465 için true
SMTP_SECURE=false
# [isteğe bağlı] production varsayılanı true (STARTTLS zorunlu). SMTP_USER varken false yapılamaz (TLS'siz kimlik yok)
# SMTP_REQUIRE_TLS=true

# --- Güvenlik / günlük ----------------------------------------------------------------------------
# [isteğe bağlı] HaveIBeenPwned parola kontrolü; production varsayılanı true
# HIBP_ENABLED=true
# [isteğe bağlı] fatal|error|warn|info|debug|trace|silent (varsayılan info)
# LOG_LEVEL=info
# [isteğe bağlı] proxy sağlık kontrolü hedefi
# PROXY_CHECK_URL=https://www.gstatic.com/generate_204

# --- Telegram (isteğe bağlı; token yoksa bağlama akışı 503 FEATURE_DISABLED) -------------------------
# Token verilirse production'da TELEGRAM_MODE=webhook ve TELEGRAM_WEBHOOK_SECRET zorunlu.
# Webhook kurulumu: node scripts/telegram-webhook.mjs set
# TELEGRAM_BOT_TOKEN=<BotFather token'ı>
# TELEGRAM_BOT_USERNAME=<bot kullanıcı adı>
# TELEGRAM_MODE=webhook
# TELEGRAM_WEBHOOK_SECRET=<openssl rand -hex 32>
# TELEGRAM_API_BASE=https://api.telegram.org

# --- Worker / scheduler -----------------------------------------------------------------------------
# [isteğe bağlı] worker replika sayısı (varsayılan 2); scheduler daima 1
# WORKER_REPLICAS=2
# [isteğe bağlı] Postgres max_connections (varsayılan 150). Koşul:
#   API_DB_CONNECTION_LIMIT + WORKER_REPLICAS × WORKER_DB_CONNECTION_LIMIT + SCHEDULER_DB_CONNECTION_LIMIT + ~10 (migrate,
#   yedek, psql) < POSTGRES_MAX_CONNECTIONS   — varsayılanlarla 10 + 2×30 + 5 + 10 = 85
# POSTGRES_MAX_CONNECTIONS=150
# [isteğe bağlı] eşzamanlılıklar (artırırsanız WORKER_DB_CONNECTION_LIMIT'i de artırın)
# SCRAPE_CONCURRENCY=2
# ANALYZE_CONCURRENCY=4
# MATCH_CONCURRENCY=4
# NOTIFY_CONCURRENCY=8
# SCHEDULER_TICK_MS=15000
# MONITOR_INTERVAL_MS=60000
# [isteğe bağlı] kapanışta aktif iş bekleme süresi (en fazla 38000; +5 sn zorla kapatma +2 sn pay, compose stop_grace_period 45s)
# SHUTDOWN_TIMEOUT_MS=30000

# --- Web ----------------------------------------------------------------------------------------------
# [isteğe bağlı] CSP img-src'e eklenecek, boşlukla ayrılmış http(s) origin'leri
# CSP_IMG_EXTRA=https://img.example.com

# --- Migrate (tek seferlik) ---------------------------------------------------------------------------
# SEED_ON_MIGRATE yalnız İLK kurulumda true; sonra false (varsayılan false). Seed planları ve marka/model eşlemelerini
# ekler; SEED_ADMIN_EMAIL verilmişse o hesabı her çalıştığında yeniden SUPER_ADMIN + ACTIVE yapar (askıya alınmış ya
# da rolü düşürülmüş hesabı geri getirir). İlk kurulumdan sonra üç satırı da yorum yapın/silin.
# SEED_ON_MIGRATE=true
# [ilk kurulum] süper admin; parola production'da en az 12 karakter, '<' '>' içeremez (yer tutucu kopyalanırsa
# seed reddeder). Girişten sonra parolayı panelden değiştirin.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=<en az 12 karakter, güçlü parola>

# --- Yedek (backup servisi; docs/operations/backup-restore.md) ----------------------------------------
# [isteğe bağlı] cron ifadesi: 5 alan, yalnız sayı ve * / , - (ör. @daily ya da MON kabul edilmez); varsayılan 03:00
# BACKUP_CRON=0 3 * * *
# [isteğe bağlı] saat dilimi (varsayılan Europe/Istanbul; yaz saati yok). Dump adları bu saatle üretilir ve rotasyon ada
# göre sıralar: kurulumdan sonra DEĞİŞTİRMEYİN.
# BACKUP_TZ=Europe/Istanbul
# [isteğe bağlı] saklama: en yeni N günlük + M haftalık dump (varsayılan 7 + 4); haftalık gün 1=Pzt..7=Paz (varsayılan 7)
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# BACKUP_WEEKLY_DAY=7
# [isteğe bağlı] healthcheck: en yeni günlük dump bundan eskiyse unhealthy (dakika, en az 60; varsayılan 1560 = 26 sa)
# BACKUP_MAX_AGE_MIN=1560
# [isteğe bağlı] S3'e yükleme: imaj WITH_AWS_CLI=true ile derlenmeli ve backup servisine egress ağı eklenmeli.
# Önerilen yol rclone yan konteyneridir (dokümana bakın).
# BACKUP_S3_URI=s3://<kova>/oto
# AWS_ACCESS_KEY_ID=<erişim anahtarı>
# AWS_SECRET_ACCESS_KEY=<gizli anahtar>
# AWS_DEFAULT_REGION=eu-central-1
# AWS_ENDPOINT_URL=<S3 uyumlu servis adresi; AWS için boş>

# --- İmaj etiketleri (isteğe bağlı; kayıt defterinden çekmek için) ------------------------------------
# OTO_IMAGE_PREFIX=oto
# OTO_TAG=latest
